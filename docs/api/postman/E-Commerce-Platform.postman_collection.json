    {
      "name": "0 Auth",
      "description": "Gets every token the other folders use. Run this folder first.",
      "item": [
        {
          "name": "Customer token (customer-test)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/ecommerce-platform/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "user-sign-in"
                },
                {
                  "key": "username",
                  "value": "customer-test"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
