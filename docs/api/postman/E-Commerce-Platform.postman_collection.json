        {
          "name": "Create payment (payment-operator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{paymentOperatorToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              }
            ],
            "url": "{{paymentUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"amount\": 49.90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('paymentKey', 'postman-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('paymentOrderId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));",
                  "pm.collectionVariables.set('paymentId', pm.response.json().paymentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key and body -> 200 (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
