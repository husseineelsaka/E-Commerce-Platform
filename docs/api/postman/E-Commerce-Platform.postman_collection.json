    {
      "name": "5 Internal (Compose network only)",
      "description": "Service-to-service endpoints with no Gateway route and no host port. They work when the collection runs inside the Compose network (Newman in a container, see docs/api/README.md). From the host they fail to connect, by design.",
      "item": [
        {
          "name": "Stock check (order-service token)",
