# Replace every CHANGE_ME value before starting infrastructure.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# Host port for PostgreSQL. Change it (e.g. 5433) if a local PostgreSQL already uses 5432;
# then set the matching *_DB_PORT for each service.
POSTGRES_HOST_PORT=5432
PRODUCT_DB_PASSWORD=CHANGE_ME_PRODUCT_DB
ORDER_DB_PASSWORD=CHANGE_ME_ORDER_DB
PAYMENT_DB_PASSWORD=CHANGE_ME_PAYMENT_DB
INVENTORY_DB_PASSWORD=CHANGE_ME_INVENTORY_DB
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
ADMIN_USER_PASSWORD=CHANGE_ME_ADMIN_USER
CUSTOMER_USER_PASSWORD=CHANGE_ME_CUSTOMER_USER
GATEWAY_CLIENT_SECRET=CHANGE_ME_GATEWAY_CLIENT
ORDER_CLIENT_SECRET=CHANGE_ME_ORDER_CLIENT
PAYMENT_OPERATOR_CLIENT_SECRET=CHANGE_ME_PAYMENT_OPERATOR_CLIENT
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN
