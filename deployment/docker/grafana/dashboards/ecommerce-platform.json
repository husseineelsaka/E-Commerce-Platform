            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (application) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM heap used by service",
      "description": "",
